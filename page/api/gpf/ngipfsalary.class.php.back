           function getArrearData($salary)
           {
             global $db;
              $Where = array();
              $Where[] = 'delete_status=1';
              $Where[] = 'is_saved=1';
              
              $Where[] = "salary_monthyear='".$salary->salary_monthyear."'";
             
              $Where[] = "status_flag =3"; 
              //$Where[] = "emp_id_fk = 26257"; 
              $Where[] = "emp_id_fk = ".$salary->emp_id_pk;             
              $Query = "SELECT arrear_from_date, arrear_to_date, net from prd_employee_arrear WHERE ".implode(" AND ",$Where).' order by arrear_id_pk desc';
              $arrearData = $db->fetch_obj($Query);
              $arrearData = $arrearData[0];
              return $arrearData;
             //print_r($arrearData); exit;
           }        

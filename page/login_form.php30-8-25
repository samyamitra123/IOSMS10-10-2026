<style>

#password-strength-status {padding: 5px 10px;color: #FFFFFF; border-radius:4px;margin-top:5px;}
.medium-password{background-color: #E4DB11;border:#BBB418 1px solid;}
.weak-password{background-color: #FF6600;border:#AA4502 1px solid;}
.strong-password{background-color: #12CC1A;border:#0FA015 1px solid;}
</style>


<!--<script src="verification.js" type="text/javascript"></script>-->
<script>


function validate_emp(){
	var emp_id = $("#emp_id").val();
	
	var shortPostCode = emp_id.substring(0,2);
    var validPostCode = /^(PE)/;
	
	if(!shortPostCode.match(validPostCode)){
		$('#password-strength-status').removeClass();
		$('#password-strength-status').addClass('weak-password');
		$('#password-strength-status').html("Not a valid Employee ID.");
	}
			
	else if(emp_id.length < 12){
		$('#password-strength-status').removeClass();
		$('#password-strength-status').addClass('weak-password');
		$('#password-strength-status').html("Not a valid Employee ID.");
	}
	else if (emp_id.length == 12){
			
		$('#password-strength-status').removeClass();
		$('#password-strength-status').addClass('strong-password');
		$('#password-strength-status').html("Valid Employee ID.");
	}
}


function sendOTP(pin)
	{
		//alert(pin);
		$(".error").html("").hide();
		var emp_id = $("#emp_id").val();
		var mob_number = $("#mob_number").val();
		//alert(un);
		if (emp_id.length == 12 && emp_id != null) {
			
			
			var input = {
			"emp_id" : emp_id,
			"mob_number" : mob_number,
			"action" : pin
			};
				$.ajax({
				//url : 'controller.php',
				url : 'otp.php',
				type : 'POST',
				data : input,
					success : function(response) {
					//alert(response);
					
					//return false;
					var result = $.parseJSON(response);
					//$('#error_1').html(result[1]);
					//$('#number_msg').html(result[0]);
					//$('#number_msg').html('OTP has been sent to this number: '+result[1]);
					//return false;
					//var response='1';
					
					if(result[1]=='1')
					{
						//alert(111);
						$('#emp_id').attr("readonly","true");
						$('#mob_number').attr("readonly","true");
						$('#pw_level').show();
						$('#pw').show();
						$('#submit').show();
						$('#regeneratePIN').show();
						$('#submit_otp').hide();
						$('#error_1').hide();
						$('#number_msg').html(result[0]);
						return false;
					}
					else if(result[1]=='2')
					{
						//alert(result[0]);
						$('#emp_id').attr("readonly","true");
						$('#mob_number').attr("readonly","true");
						$('#pw_level').show();
						$('#pw').show();
						$('#submit').show();
						$('#submit_otp').hide();
						$('#error_1').hide();
						$('#number_msg').html(result[0]);
						return false;
					}
					else if(result[1]=='3'){
						$('#error_1').html(result[0]);
					}
					else
					{
						$('#submit_otp').show();
						$('#error_1').show();
						$('#pw_level').hide();
						$('#pw').hide();
						$('#submit').hide();
						$('#regeneratePIN').hide();
					}
				
				}
			});
		} 
	else {
		//alert(12); return false;
		$(".error").html('Please enter a valid Employee ID!')
		$(".error").show();
	}
	
	$('#password-strength-status').hide();
	
	}

</script>


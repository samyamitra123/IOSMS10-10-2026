function dateshow($dateval)
{	
	if(!empty($dateval)){
		$date=substr($dateval,0,10);
		$datearr=explode('-',$date);
		//var_dump($datearr);
		$dob= $datearr['2'].'-'.$datearr['1'].'-'.$datearr['0'];
		return $dob=='--'?'':$dob;
	}
	
}
	



	$type=$_GET['type'];
	//echo $type;exit;
	$upload_id=$_GET['upload_id'];
	//echo $upload_id;
	$db=new database();
	$file=$db->fetch_table('select "oid" from prd_file where upload_id_fk='.$upload_id.' AND flag=1');
	$oid=$file['0']["oid"];
//	$file_name=$_GET['file'];


	
	if($type==1){
		$file = '../readwrite/upload/notice/'.$oid.'.pdf';
		//echo $file;exit;
	}
	else if($type==2){
		$file = '../readwrite/upload/news_events/'.$oid.'.pdf';
	}
	
	header("Content-disposition: attachment; filename=".$oid.".pdf");
	header("Content-type: application/pdf");
	readfile($file);

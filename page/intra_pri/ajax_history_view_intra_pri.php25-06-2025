function saveTocookie(thisobj)
 {
 	 var cookieName = '<?php echo $savingCookieName; ?>';
 	 var textValue = thisobj.value;
 	 if(textValue.length > 5)
 	 	 {
					var timeToAdd = 1000 * 60 * 60 * 24 * 7 * 4 * 6;
					var date = new Date();
					var expiryTime = parseInt(date.getTime()) + timeToAdd;
					date.setTime(expiryTime);
					var utcTime = date.toUTCString();
					document.cookie = cookieName+"="+textValue+"; expires=" + utcTime + ";"; 	
	   } 
 }
